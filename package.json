{
  "name": "tono-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:audio": "node scripts/site-audio.mjs",
    "docs:dev": "npm run docs:audio && vitepress dev docs",
    "docs:build": "npm run docs:audio && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:audio && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
