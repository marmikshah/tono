{
  "name": "tono-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:audio": "cargo run --locked --release -p tono --example site_samples -- docs/public/generated/sfx",
    "docs:dev": "npm run docs:audio && vitepress dev docs",
    "docs:build": "npm run docs:audio && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:audio && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vitepress": "2.0.0-alpha.20",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
